# DeployGuard local development configuration
# Copy to .env and fill in actual values

# Application
APP_NAME=DeployGuard
ENVIRONMENT=development
DEBUG=false

# Google Cloud (use stub values for local dev without real credentials)
GOOGLE_PROJECT_ID=deployguard-local
GOOGLE_API_KEY=stub

# Agent Gateway
GATEWAY_ENABLED=true
GATEWAY_STRICT_MODE=false
