# =============================================================================
# DeployGuard Environment Configuration Template
# =============================================================================
# Copy this file to .env and customize values for your deployment environment.

# -----------------------------------------------------------------------------
# 1. Google Cloud Platform Configuration
# -----------------------------------------------------------------------------
# The Google Cloud Project ID hosting Firestore, Vertex AI, Cloud Monitoring,
# Cloud Logging, and Cloud Deploy resources.
GOOGLE_CLOUD_PROJECT=deployguard-507111

# Primary GCP region for regional services (Cloud Run, Cloud Deploy, Firestore)
GOOGLE_CLOUD_LOCATION=us-central1

# Toggle live GCP SDK connectivity vs local in-memory simulation stubs:
#   false = Connect to live GCP APIs via Application Default Credentials (ADC)
#   true  = Use fast deterministic in-memory mock stubs (ideal for offline tests)
DEPLOYGUARD_MOCK_GCP=false
USE_LIVE_GCP=true

# Optional: Google API Key if using direct Gemini API instead of Vertex ADC
# GOOGLE_API_KEY=your-api-key-here

# -----------------------------------------------------------------------------
# 2. Application & Runtime Settings
# -----------------------------------------------------------------------------
APP_NAME=DeployGuard
APP_VERSION=0.1.0
DEBUG=false
ENVIRONMENT=development  # development | staging | production
PORT=8080

# -----------------------------------------------------------------------------
# 3. Agent Gateway & Policy Engine Settings
# -----------------------------------------------------------------------------
# Enforces least-privilege RBAC on tool execution via AgentRegistry
GATEWAY_ENABLED=true

# In strict mode, any unauthorized tool call immediately halts pipeline execution
GATEWAY_STRICT_MODE=false

# -----------------------------------------------------------------------------
# 4. AI Models & Reasoning Gate
# -----------------------------------------------------------------------------
# Primary reasoning model for Decision and Postmortem agents
GEMINI_MODEL=gemini-2.5-flash

# Minimum confidence score (0.0 - 1.0) required to authorize automatic rollback
MIN_CONFIDENCE_THRESHOLD_PROD=0.85
MIN_CONFIDENCE_THRESHOLD_STAGE=0.70

# Maximum deployment age in seconds to qualify for automated rollback (default 30m)
MAX_DEPLOYMENT_AGE_SECONDS=1800

# -----------------------------------------------------------------------------
# 5. OpenTelemetry & Distributed Tracing
# -----------------------------------------------------------------------------
OTEL_SERVICE_NAME=deployguard-fleet
# When DEPLOYGUARD_MOCK_GCP=false, traces are automatically exported to Cloud Trace
